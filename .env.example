# =============================================================================
# AgentFxTrading — Environment Configuration
# =============================================================================

# Bind address and port when started with `python app/server.py` (the systemd
# service passes --host / --port to uvicorn itself).
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Dashboard login (app/auth.py). With both set, the dashboard asks for them; the cBots' direct calls to
# 127.0.0.1:8000 need nothing. Unset = no login (keep nginx Basic auth in front of the server then).
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=<a long random password>

# Telegram alerts (app/alerts.py): ERROR / CRITICAL log lines, server start / stop and watchdog restarts go to
# this chat. Both unset = no alerts. See docs/configuration.md#telegram-alerts.
# TELEGRAM_BOT_TOKEN=<token from @BotFather>
# TELEGRAM_CHAT_ID=<your chat id, or -100… for a group>

# PostgreSQL in production; without it the server falls back to SQLite portfolio.db.
# DATABASE_URL=postgresql://agentfx:<password>@127.0.0.1:5432/agentfx

# Host directory mounted as /root inside every cBot container. It holds
# ctrader_data/ (cTID password files) and cAlgo/ (ctrader-console build output).
# The VPS installer (scripts/install.sh) sets this to /home/forge/ctrader.
CTRADER_HOME=/root

# A2-D5L executor (app/a2_live.py, docs/a2-live.md). Dry run unless A2_LIVE=1. The key must allow futures trading
# only (no withdrawals), on a sub-account nothing else trades, restricted to the VPS IP.
# A2_LIVE=0
# A2_BINANCE_KEY=
# A2_BINANCE_SECRET=
# A2_NOTIONAL_USDT=0
# A2_PHASEIN_TRADES=10
# A2_PHASEIN_FRACTION=0.25
# A2_LEVERAGE=3
# A2_MAX_OPEN=3
# A2_MAX_ENTRY_DELAY_S=10
# A2_MAX_HOLD_H=6
# A2_CAPTURE_DIR=/home/forge/tg_capture_a2
# A2_STATE_DIR=data/a2_live
